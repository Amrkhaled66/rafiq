{
  "expo": {
    "name": "Rafiq",
    "slug": "rafiq",
    "version": "1.0.0",
    "icon": "./assets/images/app-icon.png",
    "orientation": "portrait",
    "scheme": "rafiq",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amrkhaled66.rafiq",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "ar"
        ]
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "package": "com.amrkhaled66.rafiq",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#A60F12"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/adaptive-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#A60F12"
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-localization",
        {
          "forcesRTL": true,
          "supportedLocales": {
            "android": [
              "ar"
            ],
            "ios": [
              "ar"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#A60F12"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3a56f135-b69f-4092-b575-efb902e827cf"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/3a56f135-b69f-4092-b575-efb902e827cf"
    }
  }
}
